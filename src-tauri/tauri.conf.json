{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maia Soccer Manager",
  "version": "1.0.0",
  "identifier": "com.maiasoccermanager.msm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maia Soccer Manager",
        "width": 1280,
        "height": 850,
        "minWidth": 360,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["apk"],
    "icon": ["icons/icon.png"]
  }
}

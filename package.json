{
  "name": "jornada-90-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Jornada 90 Manager - simulador de carreira de técnico e diretor técnico",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cap": "npx cap sync",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android",
    "audio:import": "node scripts/import-audio.mjs",
    "audio:validate": "node scripts/validate-audio.mjs",
    "audio:report": "node scripts/audio-report.mjs",
    "data:rosters": "node scripts/sync-rosters.mjs",
    "quality:scan": "node scripts/quality-scan.mjs",
    "content:build": "python3 scripts/generate-content-pack.py",
    "diag:smoke": "node scripts/diag-smoke.mjs",
    "visual:scan": "node scripts/visual-scan.mjs"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@capacitor/haptics": "7.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@capacitor/android": "7.4.3",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  }
